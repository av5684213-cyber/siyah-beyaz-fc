{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    { "path": "/api/cron/match-scheduler",            "schedule": "0 9,15 * * 1-4" },
    { "path": "/api/cron/match-scheduler-cup",         "schedule": "0 15 * * 0,6" },
    { "path": "/api/cron/match-scheduler-playoff",    "schedule": "0 9,15 * * 5" },
    { "path": "/api/cron/match-tick",                  "schedule": "*/2 7-20 * * 0-6" },
    { "path": "/api/cron/match-simulator",             "schedule": "0 9,15 * * 0-6" },
    { "path": "/api/cron/process-match-queue",         "schedule": "*/5 8-20 * * 0-6" },
    { "path": "/api/cron/weekly-income",               "schedule": "0 6 * * 1" },
    { "path": "/api/cron/bot-actions",                 "schedule": "0 7 * * 0-6" },
    { "path": "/api/cron/update-player-values",        "schedule": "0 2 * * 1" },
    { "path": "/api/cron/update-form-ratings",         "schedule": "0 3 * * *" },
    { "path": "/api/cron/youth-training",              "schedule": "0 4 * * 1" },
    { "path": "/api/cron/check-academy-upgrades",      "schedule": "0 * * * *" },
    { "path": "/api/cron/season-end",                  "schedule": "0 21 * * 2" },
    { "path": "/api/cron/apply-training",              "schedule": "5 12,18 * * 1-5" },
    { "path": "/api/cron/match-reminder",              "schedule": "50 8,14 * * 1-4" },
    { "path": "/api/cron/match-reminder-cup",          "schedule": "50 14 * * 0,6" },
    { "path": "/api/cron/weekly-evolution",            "schedule": "55 23 * * 0" },
    { "path": "/api/cron/auction-cleanup",             "schedule": "*/30 * * * *" },
    { "path": "/api/cron/weekly-fans",                 "schedule": "0 7 * * 1" },
    { "path": "/api/cron/daily-tasks",                  "schedule": "0 0 * * *" },
    { "path": "/api/cron/weekly-report",                "schedule": "0 6 * * 1" },
    { "path": "/api/cron/bot-economy-check",           "schedule": "0 3 * * 1" },
    { "path": "/api/cron/generate-regens",              "schedule": "30 21 * * 2" }
  ],
  "functions": {
    "src/app/api/cron/match-scheduler/route.ts":        { "maxDuration": 60 },
    "src/app/api/cron/match-scheduler-cup/route.ts":    { "maxDuration": 60 },
    "src/app/api/cron/match-scheduler-playoff/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/match-tick/route.ts":              { "maxDuration": 60 },
    "src/app/api/cron/match-simulator/route.ts":         { "maxDuration": 60 },
    "src/app/api/cron/process-match-queue/route.ts":     { "maxDuration": 60 },
    "src/app/api/cron/weekly-income/route.ts":           { "maxDuration": 60 },
    "src/app/api/cron/bot-actions/route.ts":             { "maxDuration": 60 },
    "src/app/api/cron/apply-training/route.ts":         { "maxDuration": 60 },
    "src/app/api/cron/season-end/route.ts":              { "maxDuration": 60 },
    "src/app/api/cron/update-player-values/route.ts":    { "maxDuration": 60 },
    "src/app/api/cron/update-form-ratings/route.ts":     { "maxDuration": 60 },
    "src/app/api/cron/youth-training/route.ts":          { "maxDuration": 60 },
    "src/app/api/cron/check-academy-upgrades/route.ts":  { "maxDuration": 60 },
    "src/app/api/cron/match-reminder/route.ts":          { "maxDuration": 60 },
    "src/app/api/cron/match-reminder-cup/route.ts":      { "maxDuration": 60 },
    "src/app/api/cron/weekly-evolution/route.ts":        { "maxDuration": 60 },
    "src/app/api/cron/auction-cleanup/route.ts":         { "maxDuration": 60 },
    "src/app/api/cron/weekly-fans/route.ts":              { "maxDuration": 60 },
    "src/app/api/cron/daily-tasks/route.ts":              { "maxDuration": 60 },
    "src/app/api/cron/weekly-report/route.ts":            { "maxDuration": 60 },
    "src/app/api/cron/bot-economy-check/route.ts":        { "maxDuration": 60 },
    "src/app/api/cron/generate-regens/route.ts":           { "maxDuration": 60 }
  }
}
